<Window x:Class="OrokinMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orokin Monitor"
        Width="800" Height="480"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FF0C0A08"
        FontFamily="Cambria, Georgia, serif">

    <!-- Root grid. x:Name fields are populated from code-behind each tick. -->
    <Grid x:Name="Root" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>   <!-- title bar -->
            <RowDefinition Height="*"/>    <!-- big panels -->
            <RowDefinition Height="*"/>    <!-- small panels -->
        </Grid.RowDefinitions>

        <!-- Title bar (drag to move, buttons on right) -->
        <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
            <TextBlock x:Name="TitleText" Text="OROKIN  MONITOR"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="#FFC9A763"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="ThemeBtn" Content="Theme" Width="64" Height="26"
                        Margin="4,0" Click="ThemeBtn_Click"/>
                <Button x:Name="ResetBtn" Content="Reset W" Width="64" Height="26"
                        Margin="4,0" Click="ResetBtn_Click"
                        ToolTip="Reset idle/load power min-max"/>
                <Button x:Name="MinBtn" Content="—" Width="30" Height="26"
                        Margin="4,0" Click="MinBtn_Click"/>
                <Button x:Name="CloseBtn" Content="X" Width="30" Height="26"
                        Margin="4,0" Click="CloseBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Big panels row: CPU | GPU -->
        <Grid Grid.Row="1" Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CPU -->
            <Border x:Name="CpuPanel" Grid.Column="0" Margin="6"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="CpuHead" Text="CPU" FontSize="16"
                                   Foreground="#FFC9A763"/>
                        <TextBlock x:Name="CpuName" Text="" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="#99EBE7DC"/>
                    </Grid>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="CpuTemp" Text="—" FontSize="30" Foreground="White"/>
                            <TextBlock x:Name="CpuTempLbl" Text="TEMP" FontSize="11" Foreground="#99EBE7DC"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="CpuClock" Text="—" FontSize="30" Foreground="White"/>
                            <TextBlock x:Name="CpuClockLbl" Text="CLOCK" FontSize="11" Foreground="#99EBE7DC"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4">
                        <TextBlock x:Name="CpuLoad" Text="—" FontSize="18" Foreground="White"/>
                        <Border Height="8" CornerRadius="4" VerticalAlignment="Center"
                                Margin="80,0,0,0" x:Name="CpuBarBack">
                            <Border x:Name="CpuBar" Height="8" CornerRadius="4"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="CpuPower" Grid.Row="3" Text="—" FontSize="14"
                               Foreground="White" Margin="0,4,0,0"/>
                </Grid>
            </Border>

            <!-- GPU -->
            <Border x:Name="GpuPanel" Grid.Column="1" Margin="6"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="GpuHead" Text="GPU" FontSize="16"
                                   Foreground="#FFC9A763"/>
                        <TextBlock x:Name="GpuName" Text="" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="#99EBE7DC"/>
                    </Grid>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="GpuTemp" Text="—" FontSize="30" Foreground="White"/>
                            <TextBlock x:Name="GpuTempLbl" Text="TEMP" FontSize="11" Foreground="#99EBE7DC"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="GpuClock" Text="—" FontSize="30" Foreground="White"/>
                            <TextBlock x:Name="GpuClockLbl" Text="CORE" FontSize="11" Foreground="#99EBE7DC"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4">
                        <TextBlock x:Name="GpuLoad" Text="—" FontSize="18" Foreground="White"/>
                        <Border Height="8" CornerRadius="4" VerticalAlignment="Center"
                                Margin="80,0,0,0" x:Name="GpuBarBack">
                            <Border x:Name="GpuBar" Height="8" CornerRadius="4"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="GpuExtra" Grid.Row="3" Text="—" FontSize="13"
                               Foreground="White" Margin="0,4,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Small panels row: RAM | POWER | WEATHER | TIME | VOLUME -->
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="RamPanel" Grid.Column="0" Margin="6"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="RamHead" Text="RAM" FontSize="13" Foreground="#FFC9A763"/>
                    <TextBlock x:Name="RamLoad" Text="—" FontSize="24" Foreground="White" Margin="0,8,0,0"/>
                    <TextBlock x:Name="RamUsed" Text="—" FontSize="13" Foreground="White"/>
                    <Border Height="7" CornerRadius="3" Margin="0,8,0,0" x:Name="RamBarBack">
                        <Border x:Name="RamBar" Height="7" CornerRadius="3"
                                HorizontalAlignment="Left" Width="0"/>
                    </Border>
                    <TextBlock x:Name="RamTemp" Text="" FontSize="12" Foreground="#99EBE7DC" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="PowerPanel" Grid.Column="1" Margin="6"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="PowerHead" Text="POWER" FontSize="13" Foreground="#FFC9A763"/>
                    <TextBlock x:Name="PowerNow" Text="—" FontSize="26" Foreground="White" Margin="0,6,0,0"/>
                    <TextBlock x:Name="PowerSub" Text="CPU + GPU" FontSize="11" Foreground="#99EBE7DC"/>
                    <TextBlock x:Name="PowerIdle" Text="idle —" FontSize="12" Foreground="White" Margin="0,10,0,0"/>
                    <TextBlock x:Name="PowerLoad" Text="load —" FontSize="12" Foreground="White"/>
                </StackPanel>
            </Border>

            <Border x:Name="WeatherPanel" Grid.Column="2" Margin="6"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="WeatherHead" Text="WEATHER" FontSize="13"
                               Foreground="#FFC9A763" Cursor="Hand"
                               ToolTip="Click to change city"
                               MouseLeftButtonUp="WeatherHead_Click"/>
                    <TextBlock x:Name="WeatherTemp" Text="—" FontSize="28" Foreground="White" Margin="0,6,0,0"/>
                    <TextBlock x:Name="WeatherLoc" Text="" FontSize="13" Foreground="White"
                               Cursor="Hand" MouseLeftButtonUp="WeatherHead_Click"/>
                    <TextBlock x:Name="WeatherDesc" Text="" FontSize="12" Foreground="#99EBE7DC" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="TimePanel" Grid.Column="3" Margin="6"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="TimeHead" Text="TIME" FontSize="13" Foreground="#FFC9A763"/>
                    <TextBlock x:Name="ClockText" Text="—" FontSize="34" Foreground="White" Margin="0,6,0,0"/>
                    <TextBlock x:Name="DateText" Text="" FontSize="13" Foreground="White"/>
                </StackPanel>
            </Border>

            <Border x:Name="VolumePanel" Grid.Column="4" Margin="6"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="VolumeHead" Text="VOLUME" FontSize="13" Foreground="#FFC9A763"/>
                    <TextBlock x:Name="VolText" Text="—" FontSize="28" Foreground="White" Margin="0,6,0,0"/>
                    <Border Height="7" CornerRadius="3" Margin="0,8,0,0" x:Name="VolBarBack">
                        <Border x:Name="VolBar" Height="7" CornerRadius="3"
                                HorizontalAlignment="Left" Width="0"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="VolDown" Content="−" Width="34" Height="30"
                                Margin="0,0,4,0" Click="VolDown_Click"/>
                        <Button x:Name="VolMute" Content="Mute" Width="46" Height="30"
                                Margin="0,0,4,0" Click="VolMute_Click"/>
                        <Button x:Name="VolUp" Content="+" Width="34" Height="30"
                                Click="VolUp_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
